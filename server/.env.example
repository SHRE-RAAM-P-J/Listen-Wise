# ListenWise Server Configuration (Backend only secrets)

# Server
PORT=3001
NODE_ENV=development

# Gemini API (AI Understanding Engine)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=90000

# Gnani AI Timbre TTS (Speech synthesis — future phase)
GNANI_API_KEY=

# File storage and limits
TEMP_DIR=./tmp
MAX_UPLOAD_SIZE_MB=20
MIN_URL_CONTENT_WORDS=40
MIN_URL_CONTENT_CHARS=200
