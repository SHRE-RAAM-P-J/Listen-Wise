# ==============================================================================
# ListenWise Environment Configuration Example
# ==============================================================================
# Copy this file to server/.env for local development:
#   cp .env.example server/.env
#
# IMPORTANT:
# - All API keys and secrets belong exclusively to the backend (server/.env).
# - NEVER put secrets in client/.env or frontend code.
# ==============================================================================

# Backend Server Configuration (server/.env)
PORT=3001
NODE_ENV=development

# Google Gemini API (Phase 2: AI Understanding Engine)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=90000
GEMINI_RETRY_BASE_DELAY_MS=500

# Gnani AI Timbre TTS API (Phase 3: Speech Synthesis — future)
GNANI_API_KEY=

# File storage & limits
TEMP_DIR=./tmp
MAX_UPLOAD_SIZE_MB=20
MIN_URL_CONTENT_WORDS=40
MIN_URL_CONTENT_CHARS=200

# Frontend Configuration (client/.env — OPTIONAL)
# In development, the Vite dev server automatically proxies /api to http://localhost:3001
# VITE_API_BASE_URL=
